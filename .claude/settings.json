{
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-hud@claude-hud": true,
    "cs-retro@x-rs-tools": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/discipline-reminders.sh\" red-green",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(src/**)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/discipline-reminders.sh\" plan-first",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/strategy-guard.sh\"",
            "timeout": 30,
            "statusMessage": "战略基线累积核对"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git merge*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/discipline-reminders.sh\" merge-tree",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git pull*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/discipline-reminders.sh\" merge-tree",
            "timeout": 15
          },
          {
            "type": "command",
            "if": "Bash(git rebase*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/discipline-reminders.sh\" merge-tree",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/deliverable-gate.sh\" --mode=stop",
            "timeout": 10,
            "statusMessage": "交付闸门核查"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/deliverable-gate.sh\" --mode=session-end",
            "timeout": 10,
            "statusMessage": "交付闸门存档"
          }
        ]
      }
    ]
  }
}