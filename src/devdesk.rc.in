// src/devdesk.rc.in —— configure 期经 configure_file(@ONLY) 生成 <build>/devdesk.rc，
// 仅 WIN32 由 windres 编译进 DevDesk.exe（见根 CMakeLists.txt「exe 内嵌图标」节）。
//
// 用途：exe 内嵌 WIN32 资源——资源管理器文件图标 / 桌面快捷方式 / 卸载项显示。
// ① 图标路径是 configure 期写入的绝对原生路径（@DEVDESK_ICON_ICO_ESCAPED@，
//    反斜杠双写转义；windres 对相对路径按调用 CWD 解析不可靠，沿用 EUI-NEO
//    eui_app_icon.rc 的同一约定）。
// ② 图标 ID 用数值 101：PE 资源目录里数值 ID 恒排在命名资源（EUI-NEO 经
//    eui_neo_configure_app 塞入的 IDI_APP_ICON）之前，Shell 取首个图标组 →
//    DevDesk 图标胜出；两份资源并存互不影响。
// ③ 版本号单一源 = 根 CMakeLists.txt 的 project(DevDesk VERSION ...)（VERSION
//    文件）；RC 侧不做第二份手工版本。VALUE 串保持 ASCII（windres 代码页转换
//    不确定性），中文文案不入资源。
101 ICON "@DEVDESK_ICON_ICO_ESCAPED@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "DevDesk"
            VALUE "FileDescription", "DevDesk"
            VALUE "FileVersion", "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0"
            VALUE "InternalName", "DevDesk"
            VALUE "OriginalFilename", "DevDesk.exe"
            VALUE "ProductName", "DevDesk"
            VALUE "ProductVersion", "@DEVDESK_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
