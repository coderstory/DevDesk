{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/.zcode/armory/gates/pre-tool-use.sh\" bash-gate",
              "timeoutMs": 10000,
              "statusMessage": "门禁检查：构建命令合规性"
            }
          ]
        },
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${ZCODE_PROJECT_DIR}/.zcode/armory/gates/pre-tool-use.sh\" path-gate",
              "timeoutMs": 10000,
              "statusMessage": "门禁检查：写入路径合规性"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "CLAUDE_PROJECT_DIR=\"${ZCODE_PROJECT_DIR}\" bash \"${ZCODE_PROJECT_DIR}/.claude/hooks/strategy-guard.sh\"",
              "timeoutMs": 10000,
              "statusMessage": "守卫检查：累积标记基线"
            }
          ]
        }
      ]
    }
  },
  "plugins": {
    "enabledPlugins": {
      "zcode-site@zcode-plugins-official": true,
      "autoresearch@zcode-plugins-official": false,
      "zcode-auto-resume@local-auto-resume": false,
      "devflow@dev-zcode-plugins": true,
      "visualize@zcode-plugins-official": true,
      "design@zcode-plugins-official": true,
      "computer-use@zcode-plugins-official": true,
      "image-generation@zcode-plugins-official": true,
      "video-generation@zcode-plugins-official": true,
      "github@zcode-plugins-official": true,
      "jev-decisions@zcode-plugins-official": true,
      "frontend-design@claude-plugins-official": true
    },
    "visualizeDefaultOffMigrated": true
  }
}
