    <!-- UTI 声明（如果上面对应的 UTI 系统未注册） -->
    <key>UTExportedTypeDeclarations</key>
    <array/>

    <!-- Imported 声明（编号非 DevDesk 发明的既有格式 + DevDesk 承接的未编号
