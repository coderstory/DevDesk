<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>DevDesk</string>
    <key>CFBundleDisplayName</key>
    <string>DevDesk</string>
    <key>CFBundleIdentifier</key>
    <string>com.devdesk.app</string>
    <!-- 版本号：下面两处 0.1.0 是**占位值**，打包时由 platform/macos/build-app.sh
         从构建目录 CMakeCache.txt 的 CMAKE_PROJECT_VERSION 读出，用 plutil -replace
         写进打包产物（.app 内）的 Info.plist —— 本模板文件保持占位值不变。
         真实版本单一源 = CMakeLists.txt 的 project(DevDesk VERSION ...)（VERSION 文件
         由 bump_version 目标逐次自增）。读不到版本时 build-app.sh 会打印 ⚠️ 并以占位值
         出包，不失败。 -->
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleExecutable</key>
    <string>DevDesk</string>
    <!-- App 图标：文件 = Contents/Resources/AppIcon.icns（此处只写文件名，不含扩展名）。
         icns 由 build-app.sh 在打包时放入，来源见该脚本「图标」段。
         2026-11-07 bug#158：由 DevDesk 改名 AppIcon——同名原地换 .icns 不会触发
         macOS 图标缓存失效，Dock/Finder 会一直渲染旧满幅图；换文件名强制重新渲染。 -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- 关键：注册文件类型（F-18 记事本 26 扩展，need263 批 4 棒 B 2026-11-18）。
         UTI 归组依据 = 2026-11-18 本机 UTType(filenameExtension:) 实测：
         md/markdown/json/txt/yaml/yml/log/js/mjs/css/html/htm/xml/py/cpp/cc/cxx/
         h/hpp 均有系统 UTI（见各组）；toml/ini/sql/cjs/jsx/tsx 无 → 走下方
         UTImportedTypeDeclarations 自声明（com.devdesk.*，归组「DevDesk Text」
         /「DevDesk Script」两个组）。
         ⚠ .ts 刻意不声明：系统 UTI = public.mpeg-2-transport-stream（视频），
         声明会抢视频文件关联；.ts 仅 Windows 注册表路径接管（运行时豁免见
         file_association_macos.mm macSupportedExtension）。 -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Markdown Document</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>net.daringfireball.markdown</string>
            </array>
        </dict>
        <dict>
