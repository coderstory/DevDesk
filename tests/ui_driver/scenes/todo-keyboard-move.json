{
  "version": 1,
  "steps": [
    {"type": "click", "id": "app.sidebar.item.Todo.hit",
     "_comment": "need325 A-4：Shortcut+↑/↓ 移动选中卡（组合键通路）"},
    {"type": "wait", "until": "exists", "id": "todo.btn.add"},
    {"type": "click", "id": "todo.btn.add"},
    {"type": "wait", "until": "exists", "id": "todo.dialog.newtask.input"},
    {"type": "click", "id": "todo.dialog.newtask.input"},
    {"type": "type", "text": "键移甲"},
    {"type": "key", "name": "Enter"},
    {"type": "wait", "until": "exists", "id": "todo.col.0.card.0.bg"},
    {"type": "click", "id": "todo.btn.add", "_comment": "第二张卡（验证跨位置移动而非边界 no-op）"},
    {"type": "wait", "until": "exists", "id": "todo.dialog.newtask.input"},
    {"type": "click", "id": "todo.dialog.newtask.input"},
    {"type": "type", "text": "键移乙"},
    {"type": "key", "name": "Enter"},
    {"type": "wait", "until": "exists", "id": "todo.col.0.card.1.bg"},
    {"type": "assert", "check": "text", "id": "todo.col.0.card.0.title", "op": "equals",
     "text": "键移甲", "_comment": "前置态锁：甲在 0、乙在 1"},
    {"type": "assert", "check": "text", "id": "todo.col.0.card.1.title", "op": "equals",
     "text": "键移乙"},
    {"type": "click", "id": "todo.col.0.card.0.bg",
     "_comment": "选中甲（cardClicked 同时开详情弹窗；选中态供键盘移动）"},
    {"type": "wait", "ms": 400},
    {"type": "key", "name": "Escape", "_comment": "关详情弹窗（选中态保留）"},
    {"type": "wait", "ms": 400},
    {"type": "key", "name": "Shortcut+Down", "_comment": "Ctrl/Cmd+↓ 下移选中卡"},
    {"type": "wait", "ms": 600},
    {"type": "assert", "check": "text", "id": "todo.col.0.card.0.title", "op": "equals",
     "text": "键移乙", "_comment": "位移真锁：乙升到 0 位"},
    {"type": "assert", "check": "text", "id": "todo.col.0.card.1.title", "op": "equals",
     "text": "键移甲", "_comment": "甲降到 1 位"},
    {"type": "screenshot", "path": "todo-keyboard-move.png"}
  ]
}
