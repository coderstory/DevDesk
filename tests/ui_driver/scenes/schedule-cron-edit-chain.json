{
  "version": 1,
  "steps": [
    {"type": "click", "id": "app.sidebar.item.Schedule.hit", "_comment": "need:307 cron 表达式建→存→行卡→编辑回显全链（need302 归因后补链：翻倍根因=预填默认值上追加注入文本，非事件重复投递）"},
    {"type": "wait", "ms": 600},
    {"type": "click", "id": "app.schedule.list.new.bg", "_comment": "打开新建规则弹窗"},
    {"type": "wait", "ms": 600},
    {"type": "click", "id": "app.schedule.edit.name.hit", "_comment": "requestFocus 聚焦名称字段（need300 seeding，聚焦确定性锚点）"},
    {"type": "wait", "ms": 200},
    {"type": "type", "text": "cron链路回显"},
    {"type": "assert", "check": "text", "id": "app.schedule.edit.name.text", "op": "equals", "text": "cron链路回显",
     "_comment": "name 严格 equals（t0；name 默认空，注入即全文）"},
    {"type": "click", "id": "app.schedule.edit.kind.3.bg", "_comment": "切「表达式」类（出现 cron.expr 预填输入框）"},
    {"type": "wait", "ms": 400},
    {"type": "click", "id": "app.schedule.edit.cron.expr.hit", "_comment": "点击聚焦 cron 字段（预填默认值 0 9 * * *，光标处插入语义）"},
    {"type": "wait", "ms": 600, "_comment": "给点击→焦点落地留帧（need302 复测：无此缓冲偶发文本落空被运行时静默丢弃）"},
    {"type": "key", "name": "Shortcut+A", "id": "app.schedule.edit.cron.expr.hit", "_comment": "全选预填内容（清场原语：注入前必须清，否则追加=翻倍）"},
    {"type": "wait", "ms": 150},
    {"type": "key", "name": "Backspace", "id": "app.schedule.edit.cron.expr.hit", "_comment": "删除选中内容→字段空"},
    {"type": "wait", "ms": 150},
    {"type": "type", "text": "0 9 * * *"},
    {"type": "assert", "check": "text", "id": "app.schedule.edit.cron.expr.text", "op": "equals", "text": "0 9 * * *",
     "_comment": "cron 严格 equals（t0；不清场追加时此断言即红——need302 fail-21/fail-25 同款判据）"},
    {"type": "wait", "ms": 600, "_comment": "迟到投递窗口（need302 t1 判据保留）"},
    {"type": "assert", "check": "text", "id": "app.schedule.edit.cron.expr.text", "op": "equals", "text": "0 9 * * *", "_comment": "cron equals t1（迟到翻倍检测）"},
    {"type": "click", "id": "app.schedule.edit.dialog.confirm.bg", "_comment": "保存（表达式规则）"},
    {"type": "wait", "ms": 1000, "_comment": "保存落盘 + 弹窗收场过渡"},
    {"type": "click", "id": "app.schedule.list.tab.1.hit",
     "_comment": "切「用户定时」页签——严格命中回读：弹窗若未关此处被 backdrop 截胡即红"},
    {"type": "wait", "ms": 600},
    {"type": "assert", "check": "text", "op": "contains", "text": "cron链路回显",
     "_comment": "用户列表出现行卡（无 id 全页文本命中，todo-new-task 同款机制）"},
    {"type": "click", "id": "app.schedule.list.user.0.hit", "_comment": "点首张行卡→编辑弹窗（回显链）"},
    {"type": "wait", "ms": 800},
    {"type": "assert", "check": "text", "id": "app.schedule.edit.cron.expr.text", "op": "equals", "text": "0 9 * * *",
     "_comment": "编辑回显严格 equals：存盘 specJson→表单回读链（schedule_ui_edit.cpp actionJsonField expr）"},
    {"type": "screenshot", "path": "schedule-cron-edit-echo.png", "_comment": "回显证据图"},
    {"type": "key", "name": "Escape", "_comment": "关弹窗（need300 键盘 doCancel 链顺带回归）"},
    {"type": "wait", "ms": 600},
    {"type": "click", "id": "app.sidebar.item.Home.hit",
     "_comment": "显式离场点击（命中回读证明应用存活）"},
    {"type": "wait", "until": "exists", "id": "home.h1", "timeoutMs": 3000}
  ]
}
