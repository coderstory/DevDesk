{
  "version": 1,
  "settings": {"defaultWaitTimeoutMs": 5000},
  "steps": [
    {"type": "click", "id": "app.sidebar.item.Terminal.hit", "_comment": "进终端页（onPageEnter 起会话）"},

    {"type": "wait", "until": "exists", "id": "app.term.cursor", "timeoutMs": 20000,
     "_comment": "会话 ready 判据：光标元素只在 Running 且首帧 cells 非空时建——跨平台，不依赖 %, $, PS 等提示符字形"},

    {"type": "type", "text": "echo uidrv-need242-marker", "id": "app.term.input",
     "_comment": "need242：id = 注入前 requestFocus 到捕获层（无焦点时 EUI 静默丢弃文本）"},
    {"type": "key", "name": "Enter", "id": "app.term.input"},
    {"type": "wait", "until": "text", "op": "contains", "text": "uidrv-need242-marker", "timeoutMs": 8000,
     "_comment": "回显上屏 = 文本链 TextInputEvent→writeToActive→PTY 闭环"},

    {"type": "type", "text": "printf 'uidrv-AAA\\nuidrv-BBB\\nuidrv-CCC\\n'", "id": "app.term.input"},
    {"type": "key", "name": "Enter", "id": "app.term.input"},
    {"type": "wait", "until": "text", "op": "contains", "text": "uidrv-CCC", "timeoutMs": 8000},
    {"type": "screenshot", "path": "terminal-input-01-echo.png"},

    {"type": "drag", "from": "app.term.grid.row.0", "to": "app.term.grid.row.1", "steps": 12,
     "_comment": "物理拖选 2 行（press→逐段 move→release，每段一帧）"},
    {"type": "assert", "check": "exists", "id": "app.term.sel.0",
     "_comment": "选区高亮 rect 落树 = 拖选链路走通（真死锁时此步不返回）。id 是视觉行号；bug245 修后指针→行映射已按页面原点对齐，拖 row.0→row.1 落 sel.0/sel.1"},
    {"type": "screenshot", "path": "terminal-input-02-selection.png"},

    {"type": "key", "name": "Shortcut+C", "id": "app.term.input",
     "_comment": "有选区 → 模块级 onKeyEvent 复制（app 级 keyHandler→Router 兜底）"},
    {"type": "screenshot", "path": "terminal-input-03-copied.png"}
  ]
}
