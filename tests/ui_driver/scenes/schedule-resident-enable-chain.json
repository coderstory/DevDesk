{
  "version": 1,
  "steps": [
    {"type": "click", "id": "app.sidebar.item.Schedule.hit",
     "_comment": "need325 A-5/A-6：常驻规则建存链 + 停用 chip（C-13 tzId 回归哨）"},
    {"type": "wait", "ms": 600},
    {"type": "click", "id": "app.schedule.list.new.bg", "_comment": "打开新建规则弹窗"},
    {"type": "wait", "ms": 600, "_comment": "弹窗入场过渡（过渡期 panel.hit 截胡内容点击）"},
    {"type": "click", "id": "app.schedule.edit.name.hit", "_comment": "requestFocus 聚焦名称字段"},
    {"type": "wait", "ms": 200},
    {"type": "type", "text": "need325常驻甲"},
    {"type": "assert", "check": "text", "id": "app.schedule.edit.name.text", "op": "equals",
     "text": "need325常驻甲",
     "_comment": "落字严格锁：C-13 的 tzId 乱码/注入翻倍一旦复发此处先红"},
    {"type": "click", "id": "app.schedule.edit.kind.5.bg", "_comment": "kind.5 = 常驻"},
    {"type": "wait", "ms": 400},
    {"type": "click", "id": "app.schedule.edit.dialog.confirm.bg", "_comment": "保存"},
    {"type": "wait", "ms": 1000, "_comment": "保存落盘 + 弹窗收场过渡"},
    {"type": "click", "id": "app.schedule.list.tab.1.hit",
     "_comment": "切「用户定时」——弹窗未关会被 backdrop 截胡即红，兼作弹窗关闭证明"},
    {"type": "wait", "ms": 600},
    {"type": "assert", "check": "exists", "id": "app.schedule.list.user.0.hit",
     "_comment": "行卡落地（临时数据根，用户页签首卡即本场景建的规则）"},
    {"type": "assert", "check": "text", "id": "app.schedule.list.user.0.name", "op": "contains",
     "text": "need325常驻甲", "_comment": "A-5：保存成功断言列表行卡"},
    {"type": "click", "id": "app.schedule.list.user.0.hit", "_comment": "点卡开编辑弹窗（启停入口）"},
    {"type": "wait", "ms": 600, "_comment": "弹窗入场过渡缓冲"},
    {"type": "click", "id": "app.schedule.edit.enabled.track",
     "_comment": "启用 -> 停用（need336 组件归一 ui_kit::wswitch：命中面 = <id>.track）"},
    {"type": "click", "id": "app.schedule.edit.dialog.confirm.bg", "_comment": "保存停用态"},
    {"type": "wait", "ms": 1000},
    {"type": "wait", "until": "text", "id": "app.schedule.list.user.0.tag.label", "op": "equals",
     "text": "已停用", "timeoutMs": 3000,
     "_comment": "A-6 真锁前等待：停用 tag 落树（列表刷新异步）"},
    {"type": "assert", "check": "text", "id": "app.schedule.list.user.0.tag.label", "op": "equals",
     "text": "已停用", "_comment": "A-6 真锁：停用 tag 定点 equals（非全页文本）"},
    {"type": "screenshot", "path": "schedule-resident-disabled.png", "_comment": "停用 chip 证据图"}
  ]
}
