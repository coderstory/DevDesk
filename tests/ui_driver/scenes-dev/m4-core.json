{
  "version": 1,
  "settings": {"defaultWaitTimeoutMs": 8000},
  "steps": [
    {"type": "wait", "ms": 1500},
    {"type": "click", "id": "app.sidebar.item.Markdown.hit", "_comment": "#163：md 编辑器页字号设置（B4 fontplus/fontminus/fontval）"},
    {"type": "wait", "until": "text", "op": "nonempty", "timeoutMs": 8000},
    {"type": "wait", "ms": 600},
    {"type": "dump", "path": "m4-md-before.txt"},
    {"type": "click", "id": "app.md.status.fontplus.bg"},
    {"type": "wait", "ms": 300},
    {"type": "click", "id": "app.md.status.fontplus.bg"},
    {"type": "wait", "ms": 400},
    {"type": "dump", "path": "m4-md-after.txt"},
    {"type": "screenshot", "path": "m4-md-font.png"},
    {"type": "click", "id": "app.sidebar.item.Settings.hit", "_comment": "#181 第二写者：设置页任一变更触发整份 persist"},
    {"type": "wait", "until": "exists", "id": "app.settings.card.appearance.font.slider.hit", "timeoutMs": 8000},
    {"type": "drag", "from": "app.settings.card.appearance.font.slider.hit", "to": "app.settings.card.appearance.font.pct", "steps": 12},
    {"type": "wait", "ms": 600},
    {"type": "dump", "path": "m4-settings.txt"},
    {"type": "click", "id": "app.sidebar.item.Home.hit"},
    {"type": "wait", "until": "text", "op": "nonempty", "timeoutMs": 8000},
    {"type": "click", "id": "app.sidebar.item.ReleaseGroup.hit", "_comment": "#141：展开多级菜单（行点击即展开）"},
    {"type": "wait", "ms": 900},
    {"type": "dump", "path": "m4-sidebar-expanded.txt"},
    {"type": "screenshot", "path": "m4-sidebar-expanded.png"},
    {"type": "click", "id": "app.sidebar.item.Memory.hit", "_comment": "#203：引擎带警示短语（异常前置）"},
    {"type": "wait", "until": "exists", "id": "app.memory.tabs.0.hit", "timeoutMs": 10000},
    {"type": "wait", "ms": 1500},
    {"type": "dump", "path": "m4-memory-before.txt"},
    {"type": "click", "id": "app.memory.eng.toggle.bg"},
    {"type": "wait", "ms": 5000, "_comment": "引擎启动尝试（临时根无 venv → Failed/引导态）"},
    {"type": "dump", "path": "m4-memory-engine.txt"},
    {"type": "screenshot", "path": "m4-memory-engine.png"},
    {"type": "click", "id": "app.memory.eng.detail.bg"},
    {"type": "wait", "ms": 1000},
    {"type": "dump", "path": "m4-memory-detail.txt"},
    {"type": "screenshot", "path": "m4-memory-detail.png"},
    {"type": "key", "name": "Escape"},
    {"type": "wait", "ms": 400},
    {"type": "click", "id": "app.memory.tabs.2.hit", "_comment": "审核 TAB vocab（供真库注入场景）"},
    {"type": "wait", "ms": 1500},
    {"type": "dump", "path": "m4-review.txt"},
    {"type": "screenshot", "path": "m4-review.png"},
    {"type": "click", "id": "app.sidebar.item.Agent.hit", "_comment": "#169：可用工具视图入口"},
    {"type": "wait", "until": "text", "op": "nonempty", "timeoutMs": 8000},
    {"type": "wait", "ms": 800},
    {"type": "click", "id": "app.agent.page.tools.bg"},
    {"type": "wait", "ms": 1200},
    {"type": "dump", "path": "m4-agent-tools.txt"},
    {"type": "screenshot", "path": "m4-agent-tools.png"}
  ]
}
