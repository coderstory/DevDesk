{
  "version": 1,
  "settings": {"defaultWaitTimeoutMs": 15000},
  "steps": [
    {"type": "wait", "ms": 90000, "_comment": "注入窗：robocopy venv/llama/models；真实历史经 MEMCPP_CC_PROJECTS_ROOT 指隔离副本"},
    {"type": "click", "id": "app.sidebar.item.Memory.hit"},
    {"type": "wait", "until": "exists", "id": "app.memory.tabs.1.hit", "timeoutMs": 20000},
    {"type": "wait", "until": "exists", "id": "memory.eng.toggle.bg", "timeoutMs": 10000},
    {"type": "wait", "ms": 30000, "_comment": "注入收尾缓冲"},
    {"type": "click", "id": "app.memory.eng.toggle.bg", "_comment": "开引擎：venv 快路径+llama(注入)+健康"},
    {"type": "wait", "until": "text", "id": "memory.eng.state", "op": "contains", "text": "运行中", "timeoutMs": 240000, "_comment": "引擎 Running 门"},
    {"type": "assert", "check": "text", "id": "memory.eng.state", "op": "contains", "text": "未找到 Python", "_comment": "诊断（健康应FAIL）"},
    {"type": "assert", "check": "text", "id": "memory.eng.state", "op": "contains", "text": "pip 安装", "_comment": "诊断"},
    {"type": "assert", "check": "text", "id": "memory.eng.state", "op": "contains", "text": "超时", "_comment": "诊断"},
    {"type": "assert", "check": "text", "id": "memory.eng.state", "op": "contains", "text": "未配置", "_comment": "诊断"},
    {"type": "assert", "check": "text", "id": "memory.eng.state", "op": "contains", "text": "embedding", "_comment": "诊断"},
    {"type": "click", "id": "app.memory.tabs.1.hit"},
    {"type": "wait", "until": "exists", "id": "memory.rv.card.", "timeoutMs": 150000, "_comment": "真实历史首轮建卡"},
    {"type": "dump", "path": "qa114-review-before.txt"},
    {"type": "screenshot", "path": "qa114-review-before.png"},
    {"type": "click", "id": "memory.rv.accept.", "_comment": "接受首卡→入库"},
    {"type": "wait", "ms": 10000},
    {"type": "dump", "path": "qa114-review-after.txt"},
    {"type": "click", "id": "app.memory.tabs.0.hit"},
    {"type": "wait", "ms": 2000},
    {"type": "dump", "path": "qa114-health-before.txt"},
    {"type": "click", "id": "memory.health.h1.run", "_comment": "跑评测 Recall@5"},
    {"type": "wait", "until": "exists", "id": "memory.feed.txt.7", "timeoutMs": 220000, "_comment": "采集/提炼轮次 dwell 窗（feed 增长锚）"},
    {"type": "dump", "path": "qa114-health-after.txt"},
    {"type": "screenshot", "path": "qa114-health-after.png"},
    {"type": "click", "id": "app.memory.tabs.1.hit"},
    {"type": "wait", "ms": 2000},
    {"type": "dump", "path": "qa114-review-final.txt"},
    {"type": "screenshot", "path": "qa114-review-final.png"}
  ]
}
