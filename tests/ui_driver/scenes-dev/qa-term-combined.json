{
  "version": 1,
  "settings": {"defaultWaitTimeoutMs": 15000},
  "steps": [
    {"type": "click", "id": "app.sidebar.item.Terminal.hit"},
    {"type": "wait", "until": "exists", "id": "app.term.cursor", "timeoutMs": 25000},
    {"type": "wait", "until": "text", "op": "nonempty", "timeoutMs": 60000},
    {"type": "wait", "ms": 1500},
    {"type": "screenshot", "path": "qa-baseline.png"},

    {"type": "type", "text": "echo qa249B-marker", "id": "app.term.input"},
    {"type": "key", "name": "Enter", "id": "app.term.input"},
    {"type": "wait", "until": "text", "op": "contains", "text": "qa249B-marker", "timeoutMs": 20000, "skipExit": 77},
    {"type": "wait", "ms": 1500},
    {"type": "screenshot", "path": "qa249B-echo.png"},

    {"type": "click", "id": "app.term.act.gear.bg"},
    {"type": "wait", "until": "exists", "id": "app.term.set.card", "timeoutMs": 5000},
    {"type": "wait", "ms": 2000},
    {"type": "assert", "check": "exists", "id": "app.term.set.rows.canvas"},
    {"type": "assert", "check": "text", "op": "contains", "id": "app.term.set.row.font.label", "text": "字体"},
    {"type": "screenshot", "path": "qa262B-settings.png"}
  ]
}