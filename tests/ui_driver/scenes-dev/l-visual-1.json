{
  "version": 1,
  "settings": {"defaultWaitTimeoutMs": 10000},
  "steps": [
    {"type": "click", "id": "app.sidebar.item.Markdown.hit", "_comment": "129: md 页目录树按钮 icon 体系（emoji vs FA）"},
    {"type": "wait", "ms": 800},
    {"type": "dump", "path": "l1-md-dump.txt"},
    {"type": "screenshot", "path": "l1-md.png"},

    {"type": "click", "id": "app.sidebar.item.Agent.hit", "_comment": "162/170: 智能体页建任务→详情弹窗"},
    {"type": "wait", "until": "exists", "id": "agent.empty.action.bg", "timeoutMs": 6000},
    {"type": "click", "id": "agent.empty.action.bg"},
    {"type": "wait", "until": "exists", "id": "agent.dialog.task.name.hit"},
    {"type": "type", "text": "视觉判读批L取证任务", "id": "agent.dialog.task.name.hit"},
    {"type": "click", "id": "agent.dialog.task.step.2.bg"},
    {"type": "wait", "until": "exists", "id": "agent.dialog.task.goal.hit"},
    {"type": "type", "text": "打开详情弹窗取证", "id": "agent.dialog.task.goal.hit"},
    {"type": "click", "id": "agent.dialog.task.step.3.bg"},
    {"type": "wait", "until": "exists", "id": "agent.dialog.task.save.bg"},
    {"type": "click", "id": "agent.dialog.task.save.bg"},
    {"type": "wait", "until": "exists", "id": "agent.task.1.title"},
    {"type": "wait", "ms": 800, "_comment": "等入场动画走完"},
    {"type": "dump", "path": "l1-agent-list-dump.txt"},
    {"type": "click", "id": "agent.task.1.title", "_comment": "162: 点击任务卡开详情弹窗（点击启动）"},
    {"type": "wait", "ms": 700},
    {"type": "dump", "path": "l1-agent-detail-dump.txt"},
    {"type": "screenshot", "path": "l1-agent-detail.png"},

    {"type": "click", "id": "app.sidebar.item.Terminal.hit", "_comment": "278④: reset 不点 done 关闭后是否提前落库"},
    {"type": "wait", "until": "exists", "id": "app.term.act.new.bg", "timeoutMs": 6000},
    {"type": "wait", "ms": 800},
    {"type": "click", "id": "app.term.act.gear.bg"},
    {"type": "wait", "until": "exists", "id": "app.term.set.card", "timeoutMs": 5000},
    {"type": "wait", "ms": 300},
    {"type": "dump", "path": "l1-term-open1-dump.txt"},
    {"type": "click", "id": "app.term.set.reset"},
    {"type": "wait", "ms": 300},
    {"type": "dump", "path": "l1-term-reset-dump.txt"},
    {"type": "screenshot", "path": "l1-term-reset.png"},
    {"type": "click", "id": "app.term.set.close.bg", "_comment": "× 取消通道：不点 done 关闭，应丢弃 reset"},
    {"type": "wait", "ms": 600},
    {"type": "click", "id": "app.term.act.gear.bg", "_comment": "重开弹窗看值是否被提前保存"},
    {"type": "wait", "until": "exists", "id": "app.term.set.card", "timeoutMs": 5000},
    {"type": "wait", "ms": 300},
    {"type": "dump", "path": "l1-term-open2-dump.txt"}
  ]
}
