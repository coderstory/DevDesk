{
  "version": 1,
  "settings": {
    "defaultWaitTimeoutMs": 10000,
    "seed": {"config": {"config.json:": {"enabledModules": ["home","markdown","git","todo","schedule","claude_proxy","memory","mcp","terminal","release","settings","about"]}}}
  },
  "steps": [
    {"type": "click", "id": "app.sidebar.item.Markdown.hit"},
    {"type": "wait", "ms": 600},

    {"type": "click", "id": "md.tree.new.bg", "_comment": "#130 打开新建笔记弹窗"},
    {"type": "wait", "until": "exists", "id": "md.dialog.new.input.hit", "timeoutMs": 5000},
    {"type": "type", "id": "md.dialog.new.input.hit", "text": "k-alpha"},
    {"type": "click", "id": "md.dialog.new.confirm.bg", "_comment": "创建第1篇"},
    {"type": "wait", "ms": 700},

    {"type": "click", "id": "md.tree.new.bg"},
    {"type": "wait", "until": "exists", "id": "md.dialog.new.input.hit", "timeoutMs": 5000},
    {"type": "type", "id": "md.dialog.new.input.hit", "text": "k-beta"},
    {"type": "click", "id": "md.dialog.new.confirm.bg", "_comment": "创建第2篇"},
    {"type": "wait", "ms": 700},
    {"type": "dump", "path": "k2-mdtabs.txt", "_comment": "#130 两篇笔记的 tab 条几何"},
    {"type": "screenshot", "path": "k2-mdtabs.png"},

    {"type": "click", "id": "md.note.tab.0.close.bg", "force": true, "_comment": "#130 关闭 tab0"},
    {"type": "wait", "ms": 400},
    {"type": "dump", "path": "k2-mdclosed.txt"},
    {"type": "screenshot", "path": "k2-mdclosed.png"},

    {"type": "click", "id": "app.sidebar.item.ReleaseGroup.hit", "_comment": "#134 展开发布分组找基础配置子页"},
    {"type": "wait", "ms": 600},
    {"type": "dump", "path": "k2-relgroup.txt"},

    {"type": "click", "id": "app.sidebar.item.Settings.hit", "_comment": "#155 设置页四个 tab 逐个探测"},
    {"type": "wait", "ms": 500},
    {"type": "click", "id": "app.settings.tabs.1.hit"},
    {"type": "wait", "ms": 500},
    {"type": "dump", "path": "k2-set-tab1.txt"},
    {"type": "click", "id": "app.settings.tabs.2.hit"},
    {"type": "wait", "ms": 500},
    {"type": "dump", "path": "k2-set-tab2.txt"},
    {"type": "click", "id": "app.settings.tabs.3.hit"},
    {"type": "wait", "ms": 500},
    {"type": "dump", "path": "k2-set-tab3.txt"},

    {"type": "click", "id": "app.sidebar.item.Mcp.hit", "_comment": "#144/#146/#216 MCP 页"},
    {"type": "wait", "ms": 900},
    {"type": "dump", "path": "k2-mcp.txt"},
    {"type": "scroll", "id": "app.mcp.list.scroll", "dy": 260.0, "_comment": "#144 滚列表（若未满载则无位移）"},
    {"type": "wait", "ms": 300},
    {"type": "dump", "path": "k2-mcp-scrolled.txt"},
    {"type": "scroll", "id": "app.mcp.list.scroll", "dy": -260.0},

    {"type": "click", "id": "app.mcp.card.notes_read.hit", "_comment": "#146/#216/#145 打开 notes_read 详情"},
    {"type": "wait", "until": "exists", "id": "app.mcp.dialog.detail.btn.try.bg", "timeoutMs": 6000},
    {"type": "wait", "ms": 300},
    {"type": "dump", "path": "k2-mcpdialog.txt"},
    {"type": "type", "id": "app.mcp.dialog.detail.param.path.input.hit", "text": "no-such-note.md", "_comment": "#146 填参数"},
    {"type": "wait", "ms": 200},
    {"type": "dump", "path": "k2-mcpdialog-filled.txt"},
    {"type": "click", "id": "app.mcp.dialog.detail.btn.try.bg", "_comment": "真调用"},
    {"type": "wait", "ms": 1500},
    {"type": "dump", "path": "k2-mcpresult.txt"},
    {"type": "screenshot", "path": "k2-mcpresult.png"}
  ]
}
