{
  "version": 1,
  "settings": {
    "defaultWaitTimeoutMs": 10000,
    "seed": {"config": {"config.json:": {"enabledModules": ["home","markdown","git","todo","schedule","claude_proxy","memory","mcp","terminal","release","settings","about"]}}}
  },
  "steps": [
    {"type": "click", "id": "app.sidebar.item.Schedule.hit", "_comment": "#140 新建定时任务"},
    {"type": "wait", "ms": 600},
    {"type": "click", "id": "app.schedule.list.new.bg"},
    {"type": "wait", "until": "exists", "id": "app.schedule.edit.name.hit", "timeoutMs": 5000},
    {"type": "type", "id": "app.schedule.edit.name.hit", "text": "k-task1"},
    {"type": "click", "id": "app.schedule.edit.dialog.confirm.bg", "force": true},
    {"type": "wait", "ms": 800},
    {"type": "dump", "path": "k3-sched1.txt"},
    {"type": "screenshot", "path": "k3-sched1.png"},
    {"type": "click", "id": "app.schedule.list.new.bg"},
    {"type": "wait", "until": "exists", "id": "app.schedule.edit.name.hit", "timeoutMs": 5000},
    {"type": "type", "id": "app.schedule.edit.name.hit", "text": "k-task2"},
    {"type": "click", "id": "app.schedule.edit.dialog.confirm.bg", "force": true},
    {"type": "wait", "ms": 800},
    {"type": "dump", "path": "k3-sched2.txt"},
    {"type": "screenshot", "path": "k3-sched2.png"},

    {"type": "click", "id": "app.sidebar.item.ClaudeProxy.hit", "_comment": "#126 新建 profile 带 API key（明文存储正路径）"},
    {"type": "wait", "ms": 600},
    {"type": "click", "id": "app.claude.profiles.new.bg"},
    {"type": "wait", "ms": 600},
    {"type": "dump", "path": "k3-claudeform.txt"},
    {"type": "type", "id": "app.claude.form.basic.name.hit", "text": "k-prof", "timeoutMs": 4000, "_comment": "失败则表单结构在 dump 里重找"},
    {"type": "type", "id": "app.claude.form.basic.url.hit", "text": "https://api.k-test.example/v1", "timeoutMs": 4000},
    {"type": "type", "id": "app.claude.form.basic.key.hit", "text": "sk-ktest-0123456789abcdef", "timeoutMs": 4000},
    {"type": "wait", "ms": 300},
    {"type": "dump", "path": "k3-claudefilled.txt"},
    {"type": "click", "id": "app.claude.act.edit.bg", "force": true, "_comment": "尝试保存动作"},
    {"type": "wait", "ms": 700},
    {"type": "dump", "path": "k3-claudesaved.txt"},
    {"type": "screenshot", "path": "k3-claudesaved.png"},

    {"type": "click", "id": "app.sidebar.item.Settings.hit", "_comment": "#155 同步卡查看详情弹窗"},
    {"type": "wait", "ms": 500},
    {"type": "click", "id": "app.settings.tabs.3.hit"},
    {"type": "wait", "ms": 500},
    {"type": "click", "id": "app.settings.card.github_sync.summary.toggle"},
    {"type": "wait", "ms": 600},
    {"type": "dump", "path": "k3-syndetail.txt"},
    {"type": "screenshot", "path": "k3-syndetail.png"},

    {"type": "click", "id": "app.sidebar.item.Mcp.hit", "_comment": "#145 长输出滚动约束 + #146 参数透传"},
    {"type": "wait", "ms": 800},
    {"type": "click", "id": "app.mcp.card.notes_read.hit"},
    {"type": "wait", "until": "exists", "id": "app.mcp.dialog.detail.btn.try.bg", "timeoutMs": 6000},
    {"type": "type", "id": "app.mcp.dialog.detail.param.path.input.hit", "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-no-such.md"},
    {"type": "click", "id": "app.mcp.dialog.detail.btn.try.bg"},
    {"type": "wait", "ms": 1800},
    {"type": "dump", "path": "k3-mcplong.txt"},
    {"type": "screenshot", "path": "k3-mcplong.png"}
  ]
